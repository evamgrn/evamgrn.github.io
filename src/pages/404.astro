---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada" noindex>
  <section style="padding-top: 170px; min-height: 80vh">
    <div class="cont">
      <span class="etq">Error 404</span>
      <h1 class="tit xl">Esta página <em>no existe.</em></h1>
      <p class="ent">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <div class="botones">
        <a class="btn oro" href="/">Volver al inicio</a>
        <a class="btn vidrio" href="/consultoria">Solicitar consultoría</a>
      </div>
    </div>
  </section>
</Base>
