  </section>

  <!-- 7. Cierre -->
  <section class="cierre">
    <div class="foto" aria-hidden="true"><img src="/img/edificio.webp" srcset="/img/edificio-960.webp 960w, /img/edificio.webp 1920w" sizes="100vw" alt="" width="1920" height="1081" loading="lazy" /></div>
    <div class="cont cierre-in rev">
      <img class="cierre-logo" src="/logo/vaxor-luz-halo.svg" alt="" width="150" height="150" />
      <h2 class="tit">Hablemos de tu inmobiliaria <em>y de los clientes que se te escapan.</em></h2>
      <p class="ent">20 minutos, por teléfono y sin compromiso. Me cuentas cómo trabajáis y vemos juntos qué podría mejorar.</p>
      <div class="botones">
        <a class="btn oro" href="/consultoria">Solicitar consultoría <Icono n="flecha" /></a>
        <a class="btn vidrio" href={CONTACTO.whatsapp} target="_blank" rel="noopener"><IconoWhatsApp /> Escríbeme por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Comparador «Sin sistema / Con VAXOR»
  const cambios = document.getElementById('cambios')!;
  const modos = [...document.querySelectorAll<HTMLButtonElement>('.interruptor button')];
  const ponerModo = (m: string) => {
    cambios.dataset.modo = m;
    modos.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.modo === m)));
  };
  modos.forEach(b => b.addEventListener('click', () => ponerModo(b.dataset.modo!)));
  document.querySelector<HTMLButtonElement>('[data-modo-ir]')!.addEventListener('click', () => {
    ponerModo('con');
    document.querySelector('.prob-cab')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Pestañas de «Qué hacemos». En el ordenador muestran una vista cada vez; en el móvil las vistas son un carrusel que se desliza
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.pestanas [role=tab]')];
  const barra = document.querySelector<HTMLElement>('.pestanas')!;
  const carrusel = document.getElementById('vistas')!;
  const vistas = tabs.map(t => document.getElementById(t.getAttribute('aria-controls')!)!);
  const puntos = [...document.querySelectorAll<HTMLElement>('.puntos i')];
  const movil = matchMedia('(max-width: 859px)');
  const marcar = (n: number) => {
    tabs.forEach((x, i) => { x.setAttribute('aria-selected', String(i === n)); x.tabIndex = i === n ? 0 : -1; });
    vistas.forEach((v, i) => { v.classList.toggle('activa', i === n); if (!movil.matches) v.hidden = i !== n; });
    puntos.forEach((d, i) => d.classList.toggle('activo', i === n));
    barra.scrollTo({ left: tabs[n].offsetLeft - 20, behavior: 'smooth' });
  };
  const elegir = (t: HTMLButtonElement, foco = false) => {
    const n = tabs.indexOf(t);
    if (movil.matches) carrusel.scrollTo({ left: vistas[n].offsetLeft - carrusel.offsetLeft - 20, behavior: 'smooth' });
    marcar(n);
    if (foco) t.focus();
  };
  const ajustar = () => { vistas.forEach(v => (v.hidden = movil.matches ? false : !v.classList.contains('activa'))); };
  marcar(0);
  movil.addEventListener('change', ajustar); ajustar();
  // En el móvil, la tarjeta que se ve marca la pestaña y el punto; el aviso «Desliza» se va al primer deslizamiento
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (movil.matches && e.isIntersecting) marcar(vistas.indexOf(e.target as HTMLElement));
  }), { root: carrusel, threshold: 0.6 });
  vistas.forEach(v => io.observe(v));
  carrusel.addEventListener('scroll', () => { if (carrusel.scrollLeft > 30) carrusel.parentElement!.classList.add('deslizado'); }, { passive: true });
  const porId = (id: string) => tabs.find(t => t.id === 'p-' + id);
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => elegir(t));
    t.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); elegir(tabs[(i + 1) % tabs.length], true); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); elegir(tabs[(i - 1 + tabs.length) % tabs.length], true); }
    });
  });
  // «Siguiente» dentro de cada vista (ordenador) y los cuatro pasos de la portada
  document.querySelectorAll<HTMLElement>('[data-sig], [data-ir]').forEach(b => b.addEventListener('click', () => {
    const t = porId(b.dataset.sig || b.dataset.ir!);
    if (!t) return;
    elegir(t);
    if (b.dataset.sig) barra.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));

  // Cómo trabajamos: pasos que avanzan solos mientras se ven, hasta que alguien toca uno
  const pasosCaja = document.getElementById('pasos')!;
  const pBtns = [...pasosCaja.querySelectorAll<HTMLButtonElement>('.p-btn')];
  const riel = document.getElementById('p-riel')!;
  let pActual = 0, pTimer = 0, pVisible = false, pManual = false;
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const verPaso = (n: number, foco = false) => {
    pActual = n;
    pBtns.forEach((b, i) => {
      b.setAttribute('aria-selected', String(i === n));
      b.tabIndex = i === n ? 0 : -1;
      b.classList.toggle('hecho', i < n);
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = i !== n;
    });
    riel.style.width = `${(n / (pBtns.length - 1)) * 100}%`;
    if (foco) pBtns[n].focus();
  };
  const programar = () => {
    clearTimeout(pTimer);
    pasosCaja.classList.toggle('auto', pVisible && !pManual && !quieto);
    if (pVisible && !pManual && !quieto) pTimer = window.setTimeout(() => { verPaso((pActual + 1) % pBtns.length); programar(); }, 6500);
  };
  const parar = () => { pManual = true; programar(); };
  pBtns.forEach((b, i) => {
    b.addEventListener('click', () => { parar(); verPaso(i); });
    b.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); parar(); verPaso((i + 1) % pBtns.length, true); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); parar(); verPaso((i - 1 + pBtns.length) % pBtns.length, true); }
    });
  });
  new IntersectionObserver(es => { pVisible = es[0].isIntersecting; programar(); }, { threshold: 0.45 }).observe(pasosCaja);
  verPaso(0);

  // Diagnóstico: una pregunta cada vez y resultado por áreas
  const AREAS: Record<string, { n: string; mejorar: string; txt: string }> = {
    captacion: { n: 'la captación', mejorar: 'propietarios', txt: 'Te faltan propietarios o dependes de que te llamen. Con campañas en tu zona, los propietarios que quieren vender o alquilar te escriben a ti.' },
    respuesta: { n: 'la respuesta', mejorar: 'responder', txt: 'Hay contactos que esperan horas o días. Cuando les contestas, muchos ya han escrito a otra inmobiliaria.' },
    seguimiento: { n: 'el seguimiento', mejorar: 'seguimiento', txt: 'Los contactos que no contestan a la primera se quedan por el camino. Con un seguimiento pautado, ninguno se queda a medias.' },
  };
  const NOMBRE_AREA: Record<string, string> = { captacion: 'Captación', respuesta: 'Respuesta', seguimiento: 'Seguimiento' };
  const dForm = document.getElementById('d-form') as HTMLFormElement;
  const dq = [...dForm.querySelectorAll<HTMLFieldSetElement>('.dq')];
  const dProg = document.getElementById('d-prog')!;
  const dRes = document.getElementById('d-res')!;
  const dAtras = document.getElementById('d-atras') as HTMLButtonElement;
  const dBtn = document.getElementById('d-btn') as HTMLAnchorElement;
  const verPregunta = (n: number, foco = false) => {
    dq.forEach((f, i) => (f.hidden = i !== n));
    document.getElementById('d-paso')!.textContent = `Pregunta ${n + 1} de ${dq.length}`;
    document.getElementById('d-area')!.textContent = NOMBRE_AREA[dq[n].dataset.area!];
    (document.getElementById('d-barra') as HTMLElement).style.width = `${(n / dq.length) * 100}%`;
    dAtras.disabled = n === 0;
    if (foco) dq[n].focus();
  };
  const resultado = () => {
    const puntos: Record<string, number> = { captacion: 0, respuesta: 0, seguimiento: 0 };
    dq.forEach(f => (puntos[f.dataset.area!] += Number((f.querySelector('input:checked') as HTMLInputElement).value)));
    const estado = (p: number) => (p >= 4 ? ['Bien', 'bien'] : p >= 2 ? ['Mejorable', 'medio'] : ['Aquí se escapan', 'mal']);
    const peor = Object.keys(puntos).reduce((a, b) => (puntos[b] < puntos[a] ? b : a));
    const resumen = Object.keys(puntos).map(a => `${NOMBRE_AREA[a]}: ${estado(puntos[a])[0].toLowerCase()}`).join(' · ');
    if (puntos[peor] >= 3) {
      document.getElementById('d-tit')!.textContent = 'Lo tienes bien encaminado.';
      document.getElementById('d-txt')!.textContent = 'Tu inmobiliaria está bien en las tres áreas. Si quieres, lo repasamos juntos y vemos si hay algo que afinar.';
      dBtn.href = '/consultoria?diag=' + encodeURIComponent(resumen);
    } else {
      document.getElementById('d-tit')!.textContent = `Por dónde empezaría yo: ${AREAS[peor].n}.`;
      document.getElementById('d-txt')!.textContent = AREAS[peor].txt + ' En la consultoría lo vemos con tu caso concreto.';
      const flojas = Object.keys(puntos).filter(a => puntos[a] < 4).sort((a, b) => puntos[a] - puntos[b]).map(a => AREAS[a].mejorar);
      dBtn.href = `/consultoria?mejorar=${flojas.join(',')}&diag=${encodeURIComponent(resumen)}`;
    }
    dRes.querySelectorAll<HTMLElement>('.d-area').forEach(el => {
      const p = puntos[el.dataset.area!];
      const [txt, clase] = estado(p);
      el.dataset.estado = clase;
      el.querySelector('.d-est')!.textContent = txt;
      const barra = el.querySelector('i') as HTMLElement;
      barra.style.width = '0';
      requestAnimationFrame(() => requestAnimationFrame(() => (barra.style.width = `${Math.max(8, (p / 4) * 100)}%`)));
    });
    dForm.hidden = true; dProg.hidden = true; dRes.hidden = false; dRes.focus({ preventScroll: true });
  };
  dForm.addEventListener('change', e => {
    const i = dq.indexOf((e.target as HTMLElement).closest('fieldset') as HTMLFieldSetElement);
    setTimeout(() => (i < dq.length - 1 ? verPregunta(i + 1, true) : resultado()), 320);
  });
  dAtras.addEventListener('click', () => verPregunta(Math.max(0, dq.findIndex(f => !f.hidden) - 1), true));
  document.getElementById('d-otra')!.addEventListener('click', () => {
    dForm.reset(); dForm.hidden = false; dProg.hidden = false; dRes.hidden = true; verPregunta(0, true);
  });
</script>

<style>
  /* Portada */
  .hero { padding: 130px 0 40px; overflow: hidden; }
  .hero-in { position: relative; z-index: 2; display: grid; gap: 56px; align-items: center; }
  .hero-vis { position: relative; display: flex; justify-content: center; padding: 10px 0 30px; }
  .hero-vis .movil.inclinado { transform: rotate(4deg); width: 290px; }
  .tarjeta { position: absolute; display: flex; align-items: center; gap: 14px; padding: 12px 20px 12px 12px; border-radius: 12px; white-space: nowrap; z-index: 3;
    background: rgba(26, 24, 22, .9); }
  .tarjeta b { display: block; font-size: 15px; color: var(--tinta); line-height: 1.3; }
  .tarjeta small { display: block; font-size: 13px; color: var(--tenue); }
  .t1 { left: 0; top: 18%; } .t2 { right: 0; bottom: 4%; }
  .ej-hero { position: absolute; right: 8px; top: 0; }
  @media (max-width: 559px) { .t1 { left: -6px; top: 8%; } .t2 { right: -6px; bottom: 12%; } .tarjeta { padding: 9px 14px 9px 9px; } .tarjeta .ic { width: 38px; height: 38px; } }
  @media (min-width: 960px) {
    .hero { padding: 170px 0 56px; min-height: min(100vh, 1000px); display: flex; flex-direction: column; justify-content: center; }
    .hero-in { grid-template-columns: 1.15fr .85fr; }
    .hero-vis .movil.inclinado { width: 320px; }
    .t1 { left: -40px; } .t2 { right: -20px; }
  }
  .pilares { position: relative; z-index: 2; list-style: none; display: grid; grid-template-columns: 1fr 1fr; margin-top: 56px;
    border: 1px solid var(--linea); border-radius: 4px; background: rgba(15, 13, 11, .6); backdrop-filter: blur(10px); }
  @media (min-width: 860px) { .pilares { grid-template-columns: repeat(4, 1fr); } }
  .pilares li + li { border-left: 1px solid var(--linea); }
  @media (max-width: 859px) { .pilares li:nth-child(3) { border-left: 0; } .pilares li:nth-child(n+3) { border-top: 1px solid var(--linea); } }
  .pilares a { display: block; height: 100%; padding: 20px 22px; text-decoration: none; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--tinta); transition: background .2s; }
  .pilares a:hover { background: rgba(198, 157, 99, .1); }
  .pilares span { display: block; font-family: var(--t); font-style: italic; font-weight: 500; font-size: 34px; letter-spacing: 0; text-transform: none; color: var(--oro); line-height: 1; margin-bottom: 10px; }

  /* Lo que no se ve: comparador */
  .prob-cab { display: grid; gap: 4px; margin-bottom: 40px; }
  .prob-cab .cabeza { margin-bottom: 20px; }
  @media (min-width: 960px) { .prob-cab { grid-template-columns: 1fr auto; align-items: end; gap: 40px; } .prob-cab .cabeza { margin-bottom: 0; } }
  .interruptor { display: inline-flex; justify-self: start; padding: 5px; border-radius: 6px; border: 1px solid var(--linea); background: var(--sup); }
  .interruptor button { padding: 11px 20px; border: 0; border-radius: 4px; background: none; cursor: pointer; font-weight: 600; font-size: 15px; color: var(--suave); transition: background .25s, color .25s; }
  .interruptor button[aria-pressed="true"][data-modo="sin"] { background: rgba(220, 90, 75, .16); color: #f0b3a6; }
  .interruptor button[aria-pressed="true"][data-modo="con"] { background: var(--oro); color: #0f0d0b; }
  .rejilla-2 { display: grid; gap: 16px; }
  @media (min-width: 760px) { .rejilla-2 { grid-template-columns: 1fr 1fr; gap: 20px; } }
  .item { padding: 24px; transition: border-color .4s; }
  .cara { display: flex; gap: 18px; }
  .cara p { color: var(--suave); margin-top: 6px; font-size: 16px; }
  .cambios[data-modo="sin"] .con, .cambios[data-modo="con"] .sin { display: none; }
  .cambios .cara { animation: entra .45s ease; }
  .cambios[data-modo="con"] .item { border-color: rgba(198, 157, 99, .55); }
  .remate { margin-top: 44px; padding-left: 22px; border-left: 2px solid var(--oro); font-family: var(--t); font-style: italic; font-size: clamp(24px, 3.2vw, 30px); line-height: 1.3; color: var(--suave); }
  .remate b { color: var(--oro); font-weight: 500; }
  .remate .sig { font-style: normal; margin-left: 6px; vertical-align: middle; }

  /* Qué hacemos */
  .pestanas { display: flex; gap: 14px; overflow-x: auto; padding: 2px 2px 8px; margin-bottom: 18px; scrollbar-width: none; }
  @media (min-width: 860px) { .pestanas { justify-content: center; gap: 24px; } }
  .pestanas::-webkit-scrollbar { display: none; }
  .grupo { flex: none; display: flex; flex-direction: column; gap: 8px; }
  .grupo small { font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--tenue); padding-left: 2px; }
  .grupo + .grupo { padding-left: 14px; border-left: 1px solid var(--linea); }
  @media (min-width: 860px) { .grupo + .grupo { padding-left: 24px; } }
  .g-btns { display: flex; gap: 8px; }
  .pestanas button { flex: none; display: flex; align-items: center; gap: 10px; padding: 12px 20px; border-radius: 4px; cursor: pointer;
    background: rgba(26, 24, 22, .8); border: 1px solid var(--linea); color: var(--suave); font-weight: 600; font-size: 15px; transition: border-color .2s, color .2s; }
  .pestanas button:hover { border-color: rgba(198, 157, 99, .6); color: var(--tinta); }
  .pestanas button span { font-family: var(--t); font-style: italic; font-size: 20px; font-weight: 500; color: var(--oro); line-height: 1; }
  .pestanas button[aria-selected="true"] { color: #0f0d0b; background: var(--oro); border-color: var(--oro); }
  .pestanas button[aria-selected="true"] span { color: #0f0d0b; }
  .vista { display: grid; gap: 32px; padding: 28px 22px; overflow: hidden; animation: entra .45s ease; }
  /* Móvil: las cuatro vistas en carrusel que se desliza (asoma la siguiente), con puntos y aviso */
  .carrusel-pie { display: none; }
  @media (max-width: 859px) {
    .vista-txt .sig { display: none; }
    .grupo small { display: none; }
    .grupo + .grupo { padding-left: 0; border-left: 0; }
    .pestanas { margin: 0 -20px 14px; padding: 2px 20px 6px; }
    .pestanas button { padding: 10px 14px; font-size: 14px; }
    .vistas { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -20px; padding: 0 20px 4px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .vistas::-webkit-scrollbar { display: none; }
    .vistas .vista, .vistas .vista[hidden] { display: grid !important; grid-template-columns: minmax(0, 1fr); min-width: 0; flex: 0 0 86%; scroll-snap-align: center; animation: none; padding: 24px 18px; gap: 24px; align-content: start; }
    .vistas .vista:not(.activa) .anim-i { animation: none; }
    .vlista li { font-size: 15px; }
    .vista-vis .movil { width: 240px; }
    .accion { display: flex; flex-direction: column; }
    .pestanas { order: 0; } .carrusel-pie { order: 1; } .vistas { order: 2; }
    .carrusel-pie { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 14px; }
    .puntos { display: flex; gap: 8px; }
    .puntos i { width: 8px; height: 8px; border-radius: 8px; background: var(--sup2); transition: width .3s, background .3s; }
    .puntos i.activo { width: 24px; background: var(--oro); }
    .desliza { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--oro2); transition: opacity .4s; }
    .desliza b { display: inline-block; animation: empuja 1.2s ease-in-out infinite; }
    .deslizado .desliza { opacity: 0; }
  }
  @keyframes empuja { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(6px); } }
  @keyframes entra { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .vista, .cambios .cara { animation: none; } }
  @media (min-width: 860px) { .vista { grid-template-columns: 1fr 1fr; align-items: center; padding: 48px; min-height: 580px; } }
  .vnum { display: block; font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--oro); margin-bottom: 12px; }
  .vista h3 { font-family: var(--t); font-weight: 500; font-size: clamp(28px, 3.2vw, 36px); line-height: 1.15; }
