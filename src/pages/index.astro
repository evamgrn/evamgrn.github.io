---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import Movil from '../components/Movil.astro';
import { CONTACTO } from '../config';

const waResultados = CONTACTO.whatsapp.split('?')[0] + '?text=' + encodeURIComponent('Hola Eva, me gustaría ver resultados de vuestras campañas');

const problemas = [
  { t: 'Escriben fuera de horario', d: 'Un propietario escribe a las 21:00 y nadie le contesta hasta el día siguiente. Para entonces, puede que ya haya llamado a otra inmobiliaria.',
    ct: 'Respuesta al momento', cd: 'Quien escribe a las 21:00 recibe respuesta en ese momento, y la llamada queda en tu calendario.' },
  { t: 'Se pierden entre chats', d: 'Le contestas, pero no lo apuntas. A los dos días su conversación está debajo de otras veinte.',
    ct: 'Todo en un solo sitio', cd: 'Cada contacto queda apuntado con lo que busca y en qué punto está, venga de WhatsApp, de los portales o de la web.' },
  { t: 'El seguimiento depende de la memoria', d: 'Si nadie se acuerda de volver a escribir, el contacto se enfría.',
    ct: 'Seguimiento sin depender de nadie', cd: 'Si no contesta, recibe otro mensaje a los dos días y otro a la semana. Nadie tiene que acordarse.' },
  { t: 'Faltan propietarios', d: 'Sin producto no hay operaciones, y esperar a que llamen no siempre basta.',
    ct: 'Propietarios que llegan a ti', cd: 'Campañas en tu zona para que te escriban propietarios que quieren vender o alquilar.' },
];
const servicios = [
  { id: 'captacion', t: 'Captación' },
  { id: 'respuesta', t: 'Respuesta al momento' },
  { id: 'seguimiento', t: 'Seguimiento' },
  { id: 'avisos', t: 'Avisos en tu móvil' },
];
const preguntas = [
  { area: 'captacion', p: '¿Cuántos propietarios que quieren vender o alquilar te entran al mes?',
    o: ['Los que necesito', 'Algunos, pero me faltan', 'Casi ninguno'] },
  { area: 'captacion', p: 'Aparte de los portales, ¿haces algo para captar propietarios?',
    o: ['Sí, campañas o acciones propias', 'A veces, sin constancia', 'No, espero a que llamen'] },
  { area: 'respuesta', p: 'Si alguien te escribe un sábado a las 22:00, ¿cuándo recibe respuesta?',
    o: ['Al momento', 'Al día siguiente', 'Cuando alguien puede, a veces días después'] },
  { area: 'respuesta', p: '¿Quién contesta los mensajes de WhatsApp y de los portales?',
    o: ['Alguien encargado, y lo cubre todo', 'Quien puede, entre visita y visita', 'Yo, cuando tengo un hueco'] },
  { area: 'seguimiento', p: 'Si un contacto no contesta a tu mensaje, ¿qué pasa después?',
    o: ['Tiene un seguimiento pautado', 'Depende de si alguien se acuerda', 'Normalmente se queda ahí'] },
  { area: 'seguimiento', p: '¿Tienes todos los contactos en un solo sitio, sabiendo en qué punto está cada uno?',
    o: ['Sí, todo en un sitio', 'Repartidos entre WhatsApp, correo y portales', 'No lo tengo claro'] },
];
const areas = [
  { id: 'captacion', t: 'Captación' },
  { id: 'respuesta', t: 'Respuesta' },
  { id: 'seguimiento', t: 'Seguimiento' },
];
const pasos = [
  { ic: 'telefono', corto: 'Consultoría', t: 'Hablamos 20 minutos', d: 'Me cuentas cómo trabajáis y vemos dónde se os escapan clientes.',
    chips: ['Por teléfono o videollamada', 'Gratis', 'Sin compromiso'] },
  { ic: 'lista', corto: 'Propuesta', t: 'Te propongo solo lo que necesitas', d: 'Por escrito y con el precio cerrado. Lo decides con calma.',
    chips: ['A tu medida', 'Precio cerrado', 'Sin permanencia'] },
  { ic: 'check', corto: 'Puesta en marcha', t: 'Nos ponemos desde el primer día', d: 'Nos encargamos de toda la parte técnica. Tú sigues trabajando como siempre.',
    chips: ['Desde el día 1', 'Sin complicarte', 'Con tu WhatsApp y tu calendario'] },
  { ic: 'grafico', corto: 'Cada mes', t: 'Informe y mejoras cada mes', d: 'Ves qué ha llegado, qué se ha respondido y qué mejoramos.',
    chips: ['Informe mensual', 'Ajustes continuos', 'Trato directo conmigo'] },
];
const faqs = [
  { p: '¿Para quién es?', r: 'Para inmobiliarias que quieren más propietarios y compradores, y para las que reciben contactos por WhatsApp, Idealista o Fotocasa y saben que algunos se quedan sin respuesta.' },
  { p: '¿Necesito saber de tecnología?', r: 'No. Nosotros lo diseñamos, lo ponemos en marcha y nos encargamos de la parte técnica. Tu equipo sigue usando WhatsApp y su calendario.' },
  { p: '¿Cuánto tiempo me va a quitar?', r: 'Muy poco. Al principio, la llamada para entender cómo trabajáis y algo de material de tu inmobiliaria (fotos, zonas, lo que ofrecéis). Después, tu tiempo va a lo importante: hablar con quien ya está interesado.' },
  { p: '¿Cuánto tarda en estar funcionando?', r: 'Nos ponemos con ello desde el primer día. Cuánto tarda todo depende de lo que haga falta: en la propuesta te damos las fechas, y empezamos por lo que antes se nota.' },
  { p: '¿Funciona con Idealista y Fotocasa?', r: 'Sí. Recogemos los contactos que te llegan de los portales para que también reciban respuesta y seguimiento. Si usas un programa de gestión como Inmovilla, vemos cómo conectarlo.' },
  { p: '¿Los mensajes suenan a mi inmobiliaria?', r: 'Sí. Los preparamos contigo, con tu forma de hablar y la información de tu inmobiliaria. Y en cuanto alguien quiere visita o llamada, lo retomas tú.' },
  { p: '¿Cuánto cuesta?', r: 'Depende de lo que necesites. No trabajamos con tarifas cerradas porque cada inmobiliaria es distinta: en la consultoría vemos tu situación y te digo qué tiene sentido y cuánto cuesta, sin compromiso.' },
  { p: '¿Puedo ver resultados de vuestras campañas?', r: 'Sí. Escríbeme por WhatsApp y te enseño resultados de campañas que hemos hecho.' },
  { p: '¿Trabajáis en toda España?', r: 'Sí. Trabajamos en remoto con inmobiliarias de toda España, y las campañas se hacen para tu zona.' },
  { p: '¿Hay permanencia?', r: 'No. Si no te convence, lo dejas, sin penalizaciones.' },
];
const faqDatos = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })) });
---
<Base>
  <!-- 1. Portada -->
  <section class="hero">
    <div class="foto" aria-hidden="true"><img src="/img/edificio.webp" srcset="/img/edificio-960.webp 960w, /img/edificio.webp 1920w" sizes="100vw" alt="" width="1920" height="1081" fetchpriority="high" /></div>
    <div class="cont hero-in">
      <div class="hero-txt">
        <h1 class="tit xl">Tu inmobiliaria está perdiendo operaciones <em>mientras duermes.</em></h1>
        <p class="ent">Te traemos clientes interesados y nos aseguramos de que no se escape ninguno: ni el propietario que escribe a las 23:00 ni el comprador que pregunta un domingo.</p>
        <div class="botones">
          <a class="btn oro" href="/consultoria">Solicitar consultoría <Icono n="flecha" /></a>
          <a class="btn vidrio" href="#diagnostico">Hacer el diagnóstico</a>
        </div>
        <div class="sellos"><span>Sin compromiso</span><span>Sin permanencia</span><span>Trato directo conmigo</span></div>
      </div>
      <div class="hero-vis">
        <Movil clase="inclinado fundido" hora="23:14" nombre="Propietaria" inicial="P" mensajes={[
          { de: 'el', texto: 'Hola, estoy pensando en vender mi piso. ¿Cuánto podría valer?', hora: '23:14' },
          { de: 'tu', texto: 'Hola! Gracias por escribirnos. Para darte una idea, me dices en qué zona está y cuántas habitaciones tiene?', hora: '23:14' },
          { de: 'el', texto: 'En el centro, 3 habitaciones con terraza', hora: '23:16' },
          { de: 'tu', texto: 'Perfecto. Te llamamos mañana a las 10:00 para verlo con calma. Te va bien?', hora: '23:16' },
          { de: 'el', texto: 'Sí, perfecto', hora: '23:17' },
        ]} />
        <div class="cristal tarjeta t1 anim-i" style="--i:2"><div class="ic oro"><Icono n="check" /></div><div><b>Respondido al momento</b><small>23:14 · Propietaria, centro</small></div></div>
        <div class="cristal tarjeta t2 anim-i" style="--i:5"><div class="ic"><Icono n="calendario" /></div><div><b>Llamada mañana, 10:00</b><small>Ya en tu calendario</small></div></div>
        <span class="ejemplo ej-hero">Ejemplo</span>
      </div>
    </div>
    <div class="cont">
      <ol class="pilares rev">
        {servicios.map((s, i) => <li><a href="#que-hacemos" data-ir={s.id}><span>0{i + 1}</span>{s.t}</a></li>)}
      </ol>
    </div>
  </section>

  <!-- 2. Lo que no se ve (comparador sin sistema / con VAXOR) -->
  <section class="problema">
    <div class="cont">
      <div class="prob-cab">
        <div class="cabeza rev">
          <span class="etq">Lo que no se ve</span>
          <h2 class="tit">Cada contacto sin respuesta <em>es una operación que se va a otra.</em></h2>
        </div>
        <div class="interruptor rev" role="group" aria-label="Comparar cómo cambia">
          <button type="button" data-modo="sin" aria-pressed="true">Sin sistema</button>
          <button type="button" data-modo="con" aria-pressed="false">Con VAXOR</button>
        </div>
      </div>
      <div class="rejilla-2 cambios" id="cambios" data-modo="sin" aria-live="polite">
        {problemas.map(p => (
          <div class="cristal item rev">
            <div class="cara sin"><div class="ic rojo"><Icono n="x" /></div><div><h3 class="h3">{p.t}</h3><p>{p.d}</p></div></div>
            <div class="cara con"><div class="ic oro"><Icono n="check" /></div><div><h3 class="h3">{p.ct}</h3><p>{p.cd}</p></div></div>
          </div>
        ))}
      </div>
      <p class="remate rev">No es un problema de tu equipo. Es un problema de sistema, <b>y tiene solución.</b> <button type="button" class="sig" data-modo-ir="con">Ver cómo cambia <Icono n="flecha" /></button></p>
    </div>
  </section>

  <!-- 3. Qué hacemos (pestañas, en dos áreas) -->
  <section id="que-hacemos" class="fondo-alt">
    <div class="cont">
      <div class="cabeza centro rev">
        <span class="etq">Qué hacemos</span>
        <h2 class="tit">Más clientes que llegan a&nbsp;ti, <em>y ninguno sin respuesta.</em></h2>
        <p class="ent">Dos áreas que funcionan juntas o por separado: tú eliges por dónde empezar. Toca cada paso para ver cómo funciona en el día a día.</p>
      </div>
      <div class="accion rev">
        <div class="pestanas" role="tablist" aria-label="Qué hacemos">
          <div class="grupo" role="presentation">
            <small aria-hidden="true">Conseguir clientes</small>
            <div class="g-btns" role="presentation">
              <button role="tab" id="p-captacion" aria-controls="v-captacion" aria-selected="true"><span>01</span>Captación</button>
            </div>
          </div>
          <div class="grupo" role="presentation">
            <small aria-hidden="true">Que no se escape ninguno</small>
            <div class="g-btns" role="presentation">
              {servicios.slice(1).map((s, i) => (
                <button role="tab" id={`p-${s.id}`} aria-controls={`v-${s.id}`} aria-selected="false" tabindex="-1"><span>0{i + 2}</span>{s.t}</button>
              ))}
            </div>
          </div>
        </div>

        <div class="vistas" id="vistas">
        <div class="cristal vista" role="tabpanel" id="v-captacion" aria-labelledby="p-captacion">
          <div class="vista-txt">
            <span class="vnum">01 · Captación</span>
            <h3>Propietarios y compradores de tu zona, llegando a ti</h3>
            <p>Campañas en Facebook e Instagram para la gente de tu zona. Quien se interesa deja sus datos y entra directamente en tu sistema.</p>
            <ul class="vlista">
              <li>propietarios que quieren vender o alquilar;</li>
              <li>compradores e inquilinos;</li>
              <li>anuncios nuevos cada mes, hechos con material de tu inmobiliaria;</li>
              <li>informe mensual con lo que ha funcionado.</li>
            </ul>
            <a class="resultados" href={waResultados} target="_blank" rel="noopener"><IconoWhatsApp /><span>¿Quieres ver resultados de nuestras campañas? <b>Pídemelos por WhatsApp</b></span></a>
            <button class="sig" type="button" data-sig="respuesta">Siguiente: respuesta al momento <Icono n="flecha" /></button>
          </div>
          <div class="vista-vis anuncio-vis">
            <div class="anuncio anim-i" style="--i:0">
              <div class="an-cab"><img src="/logo/vaxor-dorado.svg" alt="" width="28" height="28" /><div><b>Tu inmobiliaria</b><small>Publicidad</small></div></div>
              <div class="an-img"><img src="/img/edificio-movil.webp" alt="" width="720" height="720" /><span>¿Pensando en vender<br /><em>tu piso este año?</em></span></div>
              <div class="an-pie"><span>Te decimos cuánto vale, sin compromiso</span><b>Más información</b></div>
            </div>
            <div class="cristal tarjeta flot anim-i" style="--i:2"><div class="ic oro"><Icono n="personas" /></div><div><b>Nuevo propietario</b><small>Quiere vender · 3 hab. · centro</small></div></div>
            <span class="ejemplo ej-vista">Ejemplo</span>
          </div>
        </div>

        <div class="cristal vista" role="tabpanel" id="v-respuesta" aria-labelledby="p-respuesta" hidden>
          <div class="vista-txt">
            <span class="vnum">02 · Respuesta al momento</span>
            <h3>Un propietario escribe a las 23:14</h3>
            <p>Recibe respuesta en ese momento, venga de donde venga: tu WhatsApp, los portales o la web.</p>
            <ul class="vlista">
              <li>respuesta por WhatsApp, también de noche y en fin de semana;</li>
              <li>preguntas para saber qué busca antes de que hables con él;</li>
              <li>la cita o la llamada, directamente en tu calendario.</li>
            </ul>
            <button class="sig" type="button" data-sig="seguimiento">Siguiente: seguimiento <Icono n="flecha" /></button>
          </div>
          <div class="vista-vis">
            <Movil clase="fundido" hora="23:14" nombre="Propietario" inicial="P" mensajes={[
              { de: 'el', texto: 'Buenas noches, quiero alquilar mi piso. ¿Os encargáis vosotros?', hora: '23:14' },
              { de: 'tu', texto: 'Hola! Sí, claro. Me dices en qué zona está y para cuándo te gustaría alquilarlo?', hora: '23:14' },
              { de: 'el', texto: 'Zona estación, a partir de enero', hora: '23:15' },
              { de: 'tu', texto: 'Genial. Te llamamos mañana a las 10:00 y lo vemos. Te va bien?', hora: '23:15' },
            ]} />
            <div class="cristal tarjeta flot anim-i" style="--i:5"><div class="ic"><Icono n="calendario" /></div><div><b>Mañana, 10:00</b><small>Llamada · alquiler zona estación</small></div></div>
            <span class="ejemplo ej-vista">Ejemplo</span>
          </div>
        </div>

        <div class="cristal vista" role="tabpanel" id="v-seguimiento" aria-labelledby="p-seguimiento" hidden>
          <div class="vista-txt">
            <span class="vnum">03 · Seguimiento</span>
            <h3>Si no contesta, nadie tiene que acordarse</h3>
            <p>Recibe un segundo mensaje a los dos días y otro a la semana. Si responde, te avisa y lo retomas tú.</p>
            <ul class="vlista">
              <li>mensajes cortos y sin presionar;</li>
              <li>recordatorios a ti y al cliente antes de cada cita;</li>
              <li>ningún contacto se queda a medias.</li>
            </ul>
            <button class="sig" type="button" data-sig="avisos">Siguiente: avisos en tu móvil <Icono n="flecha" /></button>
          </div>
          <div class="vista-vis">
            <div class="linea">
              <div class="lpaso anim-i" style="--i:0"><small>LUNES · 19:40</small><b>Pregunta por un piso</b><span>Respuesta al momento</span></div>
              <div class="lpaso anim-i" style="--i:1"><small>MIÉRCOLES</small><b>No ha contestado</b><span>Segundo mensaje, con otra opción parecida</span></div>
              <div class="lpaso anim-i" style="--i:2"><small>LUNES SIGUIENTE</small><b>Último mensaje</b><span>Corto y sin presionar</span></div>
              <div class="lpaso fin anim-i" style="--i:3"><small>RESPONDE</small><b>Te llega el aviso</b><span>Y lo retomas tú</span></div>
            </div>
          </div>
        </div>

        <div class="cristal vista" role="tabpanel" id="v-avisos" aria-labelledby="p-avisos" hidden>
          <div class="vista-txt">
            <span class="vnum">04 · Avisos en tu móvil</span>
            <h3>Te enteras de lo importante, al momento</h3>
            <p>Cuando alguien quiere visita o llamada, te llega un aviso con su nombre, qué busca y cuándo.</p>
            <ul class="vlista">
              <li>todos los contactos en un solo sitio, también los de los portales y la web;</li>
              <li>sabes en qué punto está cada uno;</li>
              <li>tú solo hablas con quien está interesado de verdad.</li>
            </ul>
            <a class="btn oro" href="/consultoria">Quiero verlo en mi inmobiliaria <Icono n="flecha" /></a>
          </div>
          <div class="vista-vis avisos">
            <span class="ejemplo ej-vista">Ejemplo</span>
            <div class="aviso anim-i" style="--i:0"><div class="ic oro"><Icono n="campana" /></div><div><small>AHORA</small><b>Visita confirmada</b><span>Laura · piso 2 hab. · jueves 18:00</span></div></div>
            <div class="aviso anim-i" style="--i:1"><div class="ic"><Icono n="telefono" /></div><div><small>HACE 12 MIN</small><b>Quiere que le llames</b><span>Marcos, propietario · vender casa</span></div></div>
            <div class="aviso anim-i" style="--i:2"><div class="ic"><Icono n="lista" /></div><div><small>8:00</small><b>Tu resumen de hoy</b><span>2 llamadas, 1 visita y 3 contactos nuevos</span></div></div>
          </div>
        </div>
        </div>
        <div class="carrusel-pie" aria-hidden="true">
          <div class="puntos">{servicios.map((_, i) => <i class={i === 0 ? 'activo' : ''}></i>)}</div>
          <span class="desliza">Desliza para ver los 4 pasos <b>→</b></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Diagnóstico (6 preguntas, una a una, con resultado por áreas) -->
  <section id="diagnostico">
    <div class="cont diag-cont">
      <div class="cabeza rev">
        <span class="etq">Diagnóstico gratuito</span>
        <h2 class="tit">¿Dónde se te escapan <em>los clientes?</em></h2>
        <p class="ent">Seis preguntas, un minuto. Al final ves cómo está tu inmobiliaria en captación, respuesta y seguimiento, y por dónde empezaría yo.</p>
        <ul class="d-sellos"><li><Icono n="check" />Sin dejar tus datos</li><li><Icono n="check" />Resultado al momento</li></ul>
      </div>
      <div class="cristal diag rev" id="diag">
        <div class="d-prog" id="d-prog">
          <div class="d-prog-txt"><span id="d-paso">Pregunta 1 de {preguntas.length}</span><span id="d-area">Captación</span></div>
          <div class="d-barra"><i id="d-barra"></i></div>
        </div>
        <form id="d-form">
          {preguntas.map((q, i) => (
            <fieldset class="dq" data-area={q.area} hidden={i > 0} tabindex="-1">
              <legend>{q.p}</legend>
              <div class="d-opc">
                {q.o.map((o, j) => (
                  <label><input type="radio" name={`q${i}`} value={2 - j} /><span class="letra" aria-hidden="true">{'ABC'[j]}</span><span>{o}</span></label>
                ))}
              </div>
            </fieldset>
          ))}
          <button type="button" class="d-atras" id="d-atras" disabled>← Anterior</button>
        </form>

        <div class="d-res" id="d-res" hidden tabindex="-1" aria-live="polite">
          <span class="vnum">Tu resultado</span>
          <h3 id="d-tit"></h3>
          <p id="d-txt"></p>
          <div class="d-areas">
            {areas.map(a => (
              <div class="d-area" data-area={a.id}>
                <div class="d-area-cab"><b>{a.t}</b><span class="d-est"></span></div>
                <div class="d-area-barra"><i></i></div>
              </div>
            ))}
          </div>
          <div class="botones">
            <a class="btn oro" id="d-btn" href="/consultoria">Verlo en la consultoría <Icono n="flecha" /></a>
            <button type="button" class="btn vidrio" id="d-otra"><Icono n="repetir" /> Repetir</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Cómo trabajamos (pasos interactivos, avanzan solos mientras se ven) -->
  <section id="como-trabajamos" class="fondo-alt">
    <div class="cont">
      <div class="cabeza centro rev">
        <span class="etq">Cómo trabajamos</span>
        <h2 class="tit">De la primera llamada <em>a tenerlo funcionando.</em></h2>
        <p class="ent">Cuatro pasos y empezamos desde el primer día. Toca cada uno.</p>
      </div>
      <div class="pasos-int rev" id="pasos">
        <div class="p-linea" role="tablist" aria-label="Cómo trabajamos">
          <div class="p-riel" aria-hidden="true"><i id="p-riel"></i></div>
          {pasos.map((p, i) => (
            <button class="p-btn" role="tab" id={`t-paso-${i}`} aria-controls={`paso-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="p-nodo"><Icono n={p.ic} /></span>
              <span class="p-n">0{i + 1}</span>
              <span class="p-t">{p.corto}</span>
              <span class="p-reloj" aria-hidden="true"><i></i></span>
            </button>
          ))}
        </div>

        {pasos.map((p, i) => (
          <div class="cristal p-panel" role="tabpanel" id={`paso-${i}`} aria-labelledby={`t-paso-${i}`} hidden={i > 0}>
            <div class="p-txt">
              <span class="vnum">Paso 0{i + 1} · {p.corto}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
              <ul class="p-chips">{p.chips.map(c => <li><Icono n="check" />{c}</li>)}</ul>
            </div>
            <div class="p-vis">
              {i === 0 && (
                <div class="v-llamada anim-i" style="--i:0">
                  <div class="vl-av"><img src="/logo/vaxor-dorado.svg" alt="" width="40" height="40" /></div>
                  <b>Llamada con Eva</b><small>Consultoría · VAXOR</small>
                  <div class="vl-ondas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  <div class="vl-temas">
                    <span class="anim-i" style="--i:1">Cómo os llegan los clientes</span>
                    <span class="anim-i" style="--i:2">Quién responde y cuándo</span>
                    <span class="anim-i" style="--i:3">Dónde se escapan</span>
                  </div>
                  <span class="vl-dur">20 min</span>
                </div>
              )}
              {i === 1 && (
                <div class="v-doc anim-i" style="--i:0">
                  <div class="vd-cab"><img src="/logo/vaxor-dorado.svg" alt="" width="32" height="32" /><div><b>Propuesta para tu inmobiliaria</b><small>Preparada a tu medida</small></div></div>
                  <ul>
                    <li class="anim-i" style="--i:1"><Icono n="check" />Captación de propietarios</li>
                    <li class="anim-i" style="--i:2"><Icono n="check" />Respuesta al momento</li>
                    <li class="anim-i" style="--i:3"><Icono n="check" />Seguimiento de cada contacto</li>
                  </ul>
                  <div class="vd-precio anim-i" style="--i:4"><span>Precio</span><b>Cerrado, sin sorpresas</b></div>
                  <span class="vd-sello anim-i" style="--i:5">Sin permanencia</span>
                </div>
              )}
              {i === 2 && (
                <div class="v-marcha anim-i" style="--i:0">
                  <div class="vm-cab"><b>Puesta en marcha</b><span>Desde el día 1</span></div>
                  {['Tu WhatsApp', 'Tu calendario', 'Contactos de los portales', 'Campañas en tu zona'].map((x, k) => (
                    <div class="vm-fila anim-i" style={`--i:${k + 1}`}><span class="vm-ok"><Icono n="check" /></span>{x}<small>Listo</small></div>
                  ))}
                  <div class="vm-barra"><i></i></div>
                </div>
              )}
              {i === 3 && (
                <div class="v-informe anim-i" style="--i:0">
                  <div class="vi-cab"><b>Tu informe del mes</b><span class="ejemplo">Ejemplo</span></div>
                  {[['Contactos nuevos', 92], ['Respondidos al momento', 100], ['Citas y llamadas', 58]].map(([x, w], k) => (
                    <div class="vi-fila"><span>{x}</span><div class="vi-barra"><i style={`--w:${w}%; --i:${k + 1}`}></i></div></div>
                  ))}
                  <div class="vi-nota anim-i" style="--i:4"><Icono n="diana" /><span><b>Este mes mejoramos</b>Los anuncios con más respuesta</span></div>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Preguntas frecuentes -->
  <section id="preguntas">
    <script type="application/ld+json" set:html={faqDatos} />
    <div class="cont faq-cont">
      <div class="cabeza rev">
        <span class="etq">Preguntas frecuentes</span>
        <h2 class="tit">Lo que me preguntan <em>antes de empezar.</em></h2>
        <p class="ent">¿Tienes otra duda? <a href={CONTACTO.whatsapp} target="_blank" rel="noopener">Escríbeme por WhatsApp</a> y te contesto yo.</p>
      </div>
      <div class="faq rev">
        {faqs.map(f => (
          <details><summary>{f.p}<span aria-hidden="true"></span></summary><p>{f.r}</p></details>
        ))}
      </div>
